{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "dawloop-features-v1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "section_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "meter": {
          "const": "4/4"
        }
      },
      "required": [
        "section_type",
        "role",
        "meter"
      ],
      "additionalProperties": false
    },
    "analyzer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "note_density",
              "register_center",
              "mean_abs_interval",
              "offbeat_ratio",
              "tension_ratio",
              "motif_change_ratio",
              "tempo",
              "phrase_length",
              "mean_velocity"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "enum": [
              "notes_per_bar",
              "midi_number",
              "semitones",
              "ratio",
              "beats_per_minute",
              "bars",
              "midi_1_127"
            ]
          },
          "definition_version": {
            "const": "dawloop-feature-v1"
          },
          "method": {
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "missing_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "definition_version",
          "method",
          "confidence",
          "evidence_ref",
          "missing_reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "source_hash",
    "scope",
    "analyzer",
    "features"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dawloop:learning:extracted_features:v1",
  "$comment": "SPDX-License-Identifier: MIT; Copyright 2026 ryurikoneko"
}
