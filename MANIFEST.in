include AGENTS.md AUTHORS CITATION.cff NOTICE LICENSE LICENSE_POLICY.md TRADEMARKS.md
include PROVENANCE.md THIRD_PARTY_NOTICES.md CONTRIBUTING.md SECURITY.md
include .gitignore .gitattributes
include README.en.md requirements-ci.txt
recursive-include .github *.yml *.allowed
recursive-include docs *.md
recursive-include learning *.py *.json *.md
recursive-include profiles/examples *.json *.yaml
recursive-include examples *.json *.py *.md
recursive-include schemas *.json
recursive-include research *.py *.js *.mjs *.pyscript *.md
recursive-include scripts *.py
recursive-include tests *.py *.json *.cjs *.mjs *.jpg *.md
recursive-include evidence/public *.json *.md
include evidence/runtime_v2/file_snapshot_route.json
global-exclude *.pyc *.pyo
prune workspace
prune profiles/personal
